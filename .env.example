# Copy to .env and edit. Do not commit real secrets.
# Both devices must stay on a trusted private Wi-Fi LAN.

SIMULATION_MODE=true
CONTROL_HOST=0.0.0.0
CONTROL_PORT=5000
VIDEO_PORT=5001
CONTROL_TOKEN=change-me
LAPTOP_IP=192.168.1.20
VIDEO_FOLLOW_CLIENT=true
VIDEO_ENABLED=true
WATCHDOG_TIMEOUT=0.5
CAMERA_DEVICE=/dev/video0
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2000k
VIDEO_RESTART_DELAY=2.0
LOG_LEVEL=INFO
LOG_FILE=
AUTH_TIMEOUT=5.0
STEER_SLOW_FACTOR=0.45
IN_PLACE_TURN_RATIO=1.0

# EXAMPLE BCM GPIO NUMBERS ONLY — confirm against your motor-driver wiring.
# Never power motors from Raspberry Pi GPIO pins.
MOTOR_FRONT_LEFT_IN1=17
MOTOR_FRONT_LEFT_IN2=18
MOTOR_FRONT_LEFT_PWM=12
MOTOR_FRONT_RIGHT_IN1=22
MOTOR_FRONT_RIGHT_IN2=23
MOTOR_FRONT_RIGHT_PWM=13
MOTOR_REAR_LEFT_IN1=24
MOTOR_REAR_LEFT_IN2=25
MOTOR_REAR_LEFT_PWM=19
MOTOR_REAR_RIGHT_IN1=5
MOTOR_REAR_RIGHT_IN2=6
MOTOR_REAR_RIGHT_PWM=26
